<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <AssemblyName>SwayMusic</AssemblyName>
    <RootNamespace>SwayMusic.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sway.ico</ApplicationIcon>
    <Product>SwayMusic</Product>
    <Description>SwayMusic native Windows music player, derived from Metrolist</Description>
    <Copyright>Copyright Metrolist Project and contributors</Copyright>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SwayMusic.Core\SwayMusic.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Updates\update-public-key.pem" />
    <Content Include="..\..\tools\*.exe;..\..\tools\*LICENSE*.txt" Link="tools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ExcludePublishedDebugSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
