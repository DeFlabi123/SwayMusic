<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SwayMusic.Desktop.ViewModels" xmlns:core="using:SwayMusic.Core" xmlns:storage="using:SwayMusic.Core.Storage" xmlns:ui="using:SwayMusic.Desktop.Controls"
 x:Class="SwayMusic.Desktop.MainWindow" x:DataType="vm:MainViewModel" x:Name="Root" Title="SwayMusic" Width="1280" Height="800" MinWidth="850" MinHeight="600" Icon="/Assets/sway.png">
 <Window.Resources>
   <DataTemplate x:Key="SongRowTemplate" x:DataType="vm:TrackRow"><Grid ColumnDefinitions="36,*,Auto,32"><Grid Width="36" Height="36"><Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource RaisedBrush}"><Grid><ui:SwayIcon Kind="music" Width="15" Height="15" Opacity="0.5"/><ui:TrackCover Track="{Binding Track}" Owner="{Binding $parent[Window].DataContext}" Stretch="UniformToFill"/></Grid></Border><Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource PanelBrush}" BorderThickness="2" IsVisible="{Binding IsCurrent}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="10,0,14,0"><TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><ItemsControl ItemsSource="{Binding ArtistLinks}" ItemTemplate="{StaticResource ArtistLinkTemplate}" ClipToBounds="True" MaxHeight="20" ToolTip.Tip="{Binding Artist}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel><TextBlock Grid.Column="2" Text="{Binding Duration}" Classes="muted" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="3" Classes="icon" Padding="6" Tag="{Binding}" Click="RowActionsClicked" AutomationProperties.Name="Song actions"><ui:SwayIcon Kind="more" Width="16"/></Button></Grid></DataTemplate>
   <DataTemplate x:Key="ArtistLinkTemplate" x:DataType="core:ArtistReference"><Button Classes="artist-link" Tag="{Binding}" Click="ArtistNameClicked" Margin="0,0,8,0" ToolTip.Tip="Open artist page" AutomationProperties.Name="{Binding Name}"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></Button></DataTemplate>
   <DataTemplate x:Key="TrackTemplate" x:DataType="vm:TrackRow">
     <Grid ColumnDefinitions="32,*,Auto" MinHeight="36">
       <Grid Width="32" Height="32"><Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource RaisedBrush}"><Grid><ui:SwayIcon Kind="music" Width="15" Height="15" Opacity="0.5"/><ui:TrackCover Track="{Binding Track}" Owner="{Binding $parent[Window].DataContext}" Stretch="UniformToFill"/></Grid></Border><Border Width="9" Height="9" CornerRadius="5" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource PanelBrush}" BorderThickness="2" IsVisible="{Binding IsCurrent}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/></Grid>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3" Margin="8,0,12,0"><TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><ItemsControl ItemsSource="{Binding ArtistLinks}" ItemTemplate="{StaticResource ArtistLinkTemplate}" ClipToBounds="True" MaxHeight="20" ToolTip.Tip="{Binding Artist}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
       <TextBlock Grid.Column="2" Text="{Binding Duration}" Classes="muted" FontSize="12" VerticalAlignment="Center"/>
     </Grid>
   </DataTemplate>
 </Window.Resources>
 <Grid RowDefinitions="*,Auto,Auto">
  <Grid ColumnDefinitions="184,*,Auto" IsEnabled="{Binding IsReady}">
   <Border Background="{DynamicResource PanelBrush}" Padding="16,26,16,18">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,32"><Image Source="/Assets/sway.png" Width="36" Height="36"/><TextBlock Text="sway" Classes="brand" VerticalAlignment="Center"/></StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Spacing="4"><Button Classes="nav" Command="{Binding SettingsCommand}" Classes.selected="{Binding ShowSettings}" AutomationProperties.Name="Settings &amp; account"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="settings"/><TextBlock Text="Settings &amp; account" FontSize="12"/></StackPanel></Button><Button Content="Open audio files" Click="OpenFilesClicked" Classes="nav" FontSize="12"/><TextBlock Text="Find your rhythm." Classes="muted" FontSize="11" Margin="12,14,0,0"/></StackPanel>
     <ScrollViewer x:Name="NavigationScroll" ClipToBounds="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Button Classes="nav" Command="{Binding HomeCommand}" Classes.selected="{Binding IsHome}" AutomationProperties.Name="Home"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="home"/><TextBlock Text="Home"/></StackPanel></Button>
      <Button Classes="nav" Click="FocusSearchClicked" Classes.selected="{Binding IsSearch}" AutomationProperties.Name="Search"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="search"/><TextBlock Text="Search"/></StackPanel></Button>
      <Button Classes="nav" Command="{Binding LibraryCommand}" Classes.selected="{Binding IsLibrary}" AutomationProperties.Name="Your library"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="library"/><TextBlock Text="Your library"/></StackPanel></Button>
      <TextBlock Text="COLLECTION" Classes="muted" FontSize="11" LetterSpacing="1.3" Margin="12,28,0,10"/>
      <Button Classes="nav" Command="{Binding LikesCommand}" Classes.selected="{Binding IsLikes}" AutomationProperties.Name="Liked songs"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="heart"/><TextBlock Text="Liked songs"/></StackPanel></Button>
      <Button Classes="nav" Command="{Binding PlaylistsCommand}" Classes.selected="{Binding IsPlaylists}" AutomationProperties.Name="Playlists"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="playlist"/><TextBlock Text="Playlists"/></StackPanel></Button>
      <Button Classes="nav" Command="{Binding ArtistsCommand}" Classes.selected="{Binding IsArtists}" AutomationProperties.Name="Artists"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="artist"/><TextBlock Text="Artists"/></StackPanel></Button>
      <Button Classes="nav" Command="{Binding DownloadsCommand}" Classes.selected="{Binding IsDownloads}" AutomationProperties.Name="Downloads"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="download"/><TextBlock Text="Downloads"/></StackPanel></Button>
      <Button Classes="nav" Command="{Binding HistoryCommand}" Classes.selected="{Binding IsHistory}" AutomationProperties.Name="Listening history"><StackPanel Orientation="Horizontal" Spacing="12"><ui:SwayIcon Kind="history"/><TextBlock Text="History"/></StackPanel></Button>
     </StackPanel></ScrollViewer>
    </DockPanel>
   </Border>
   <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="26,24,26,20">
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,24">
     <Grid><TextBox x:Name="SearchBox" Text="{Binding Query}" PlaceholderText="Search songs, artists, or paste a playlist URL" KeyDown="SearchKeyDown" Padding="38,9,68,9"/><ui:SwayIcon Kind="search" HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False"/><TextBlock Text="Ctrl F" Classes="muted" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/></Grid>
     <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Classes="primary" Margin="10,0,0,0"/>
    </Grid>
    <Grid Grid.Row="1">
     <StackPanel IsVisible="{Binding !IsArtistPage}" Spacing="6" Margin="0,0,0,22"><TextBlock Text="{Binding HeroTitle}" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.8"/><TextBlock Text="{Binding PageSubtitle}" Classes="muted" FontSize="13" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding IsAccountCollection}" Spacing="6"><WrapPanel IsVisible="{Binding IsSignedIn}"><Button Content="Sync library" Command="{Binding SyncLibraryCommand}" IsEnabled="{Binding !IsSyncing}" Margin="0,6,8,0"/><Button Content="Cancel sync" Command="{Binding CancelLibrarySyncCommand}" IsVisible="{Binding IsSyncing}" Margin="0,6,8,0"/><Button Content="{Binding ArtistSubscriptionText}" Command="{Binding ToggleArtistSubscriptionCommand}" IsEnabled="{Binding CanChangeArtistSubscription}" IsVisible="{Binding IsArtists}" Margin="0,6,0,0"/></WrapPanel><TextBlock Text="{Binding SyncStatus}" IsVisible="{Binding IsSignedIn}" TextWrapping="Wrap" Classes="muted" FontSize="12"/></StackPanel></StackPanel>
     <StackPanel IsVisible="{Binding IsArtistPage}" Spacing="10" Margin="0,0,0,16">
      <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="16"><Grid ColumnDefinitions="120,*">
       <Border Width="120" Height="120" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource RaisedBrush}"><Grid><ui:SwayIcon Kind="artist" Width="42" Height="42" Opacity="0.4"/><Image Source="{Binding ArtistArtwork}" Stretch="UniformToFill"/></Grid></Border>
       <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center" Spacing="7"><TextBlock Text="ARTIST" FontSize="10" LetterSpacing="1.5" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding PageTitle}" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.8" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ArtistStats}" Classes="muted" FontSize="12" TextWrapping="Wrap" MaxLines="2"/><Button Content="{Binding ArtistSubscriptionText}" Command="{Binding ToggleArtistSubscriptionCommand}" IsEnabled="{Binding CanChangeArtistSubscription}" HorizontalAlignment="Left" Padding="12,5" MinHeight="30"/></StackPanel>
      </Grid></Border>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="2">
     <TabControl x:Name="ArtistSections" IsVisible="{Binding IsArtistPage}" SelectedIndex="{Binding ArtistSectionIndex}">
      <TabItem Header="Songs"><Grid RowDefinitions="Auto,*,Auto" Margin="0,12,0,0">
       <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10"><TextBlock Text="{Binding TrackCount}" Classes="muted" VerticalAlignment="Center" FontSize="12"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Play" Command="{Binding PlaySelectedCommand}" Classes="primary"/><Button x:Name="ArtistShuffleButton" Command="{Binding ShuffleCollectionCommand}" ToolTip.Tip="Start at a random song" AutomationProperties.Name="Shuffle artist songs"><ui:SwayIcon Kind="shuffle" Width="18" Height="18"/></Button></StackPanel></Grid>
       <ListBox Grid.Row="1" x:Name="ArtistTrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" Tapped="TrackTapped" ContextRequested="TrackContextRequested" ItemTemplate="{StaticResource SongRowTemplate}"><ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="{Binding $parent[Window].DataContext.TrackRowHeight}"/></Style></ListBox.Styles><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ContextMenu><ContextMenu><MenuItem Header="Play" Tag="play" Click="TrackMenuClicked"/><MenuItem Header="Add to queue" Tag="enqueue" Click="TrackMenuClicked"/><MenuItem Header="Like / unlike" Tag="like" Click="TrackMenuClicked"/><MenuItem Header="Start radio" Tag="radio" Click="TrackMenuClicked"/><MenuItem Header="Download" Tag="download" Click="TrackMenuClicked"/><Separator/><MenuItem Header="Move up in queue" Tag="up" Click="TrackMenuClicked"/><MenuItem Header="Move down in queue" Tag="down" Click="TrackMenuClicked"/><MenuItem Header="Remove" Tag="remove" Click="TrackMenuClicked"/></ContextMenu></ListBox.ContextMenu></ListBox>
       <Button Grid.Row="2" Content="Load more" Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      </Grid></TabItem>
      <TabItem Header="Releases &amp; more"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding ArtistCatalog}" Margin="0,12,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:BrowseCard"><Button Classes="card" Tag="{Binding}" Click="ArtistCatalogClicked" Width="144" Margin="0,0,10,10" Padding="8"><StackPanel Spacing="6"><Border Height="120" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource RaisedBrush}"><Grid><ui:SwayIcon Kind="music" Opacity="0.3"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
      <TabItem Header="About"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" Margin="4,18,12,12"><TextBlock Text="About the artist" Classes="section"/><TextBlock Text="{Binding ArtistDescription}" IsVisible="{Binding HasArtistDescription}" TextWrapping="Wrap" FontSize="14" LineHeight="24"/><TextBlock Text="No biography is available on YouTube Music for this artist." IsVisible="{Binding !HasArtistDescription}" Classes="muted" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
     </TabControl>
     <Grid IsVisible="{Binding ShowStandardTracks}" RowDefinitions="Auto,Auto,Auto,*,Auto">
      <StackPanel IsVisible="{Binding ShowHomeCards}" Spacing="12" Margin="0,0,0,24"><TextBlock Text="{Binding HomeSectionTitle}" Classes="section"/>
       <ItemsControl ItemsSource="{Binding HomeCards}" MaxWidth="760" HorizontalAlignment="Stretch"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:HomeCard"><Button Classes="card" Click="HomeCardClicked" Tag="{Binding}" Margin="0,0,12,0" AutomationProperties.Name="{Binding Title}"><StackPanel Spacing="8"><Border Height="138" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource RaisedBrush}"><Grid><Image Source="/Assets/sway.png" Width="42" Height="42" Opacity="0.25"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,10"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"><TextBlock Text="Songs" Classes="section"/><TextBlock Text="{Binding TrackCount}" Classes="muted" FontSize="12" VerticalAlignment="Center"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Play" Classes="primary" Command="{Binding PlaySelectedCommand}"/><Button x:Name="ShuffleCollectionButton" Command="{Binding ShuffleCollectionCommand}" ToolTip.Tip="Start at a random song" AutomationProperties.Name="Shuffle collection"><ui:SwayIcon Kind="shuffle" Width="18" Height="18"/></Button><Button Content="Add to playlist" Click="AddToPlaylistClicked" ToolTip.Tip="Add the selected song to a playlist" IsVisible="{Binding HasPlaylists}"/></StackPanel></Grid>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10" IsVisible="{Binding IsLibrary}"><TextBox x:Name="LibraryFilterBox" Text="{Binding LibraryFilter}" PlaceholderText="Filter your library"/><ComboBox Grid.Column="1" x:Name="LibrarySortPicker" ItemsSource="{Binding LibrarySortOptions}" SelectedIndex="{Binding LibrarySortIndex}" Margin="10,0,0,0" MinWidth="145"/></Grid>
      <ListBox Grid.Row="3" x:Name="TrackList" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}" Tapped="TrackTapped" ContextRequested="TrackContextRequested">
       <ListBox.Styles><Style Selector="ListBoxItem"><Setter Property="MinHeight" Value="{Binding $parent[Window].DataContext.TrackRowHeight}"/></Style></ListBox.Styles>
       <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
       <ListBox.ContextMenu><ContextMenu><MenuItem Header="Play" Tag="play" Click="TrackMenuClicked"/><MenuItem Header="Add to queue" Tag="enqueue" Click="TrackMenuClicked"/><MenuItem Header="Like / unlike" Tag="like" Click="TrackMenuClicked"/><MenuItem Header="Start radio" Tag="radio" Click="TrackMenuClicked"/><MenuItem Header="Download" Tag="download" Click="TrackMenuClicked"/><Separator/><MenuItem Header="Move up in queue" Tag="up" Click="TrackMenuClicked"/><MenuItem Header="Move down in queue" Tag="down" Click="TrackMenuClicked"/><MenuItem Header="Remove" Tag="remove" Click="TrackMenuClicked"/></ContextMenu></ListBox.ContextMenu>
       <ListBox.ItemTemplate><StaticResource ResourceKey="SongRowTemplate"/></ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3" IsVisible="{Binding ShowEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="12" IsHitTestVisible="False"><Image Source="/Assets/sway.png" Width="62" Height="62" Opacity="0.7"/><TextBlock Text="{Binding EmptyTitle}" Classes="section" HorizontalAlignment="Center"/><TextBlock Text="{Binding EmptyMessage}" Classes="muted" TextWrapping="Wrap" TextAlignment="Center"/></StackPanel>
      <Button Grid.Row="4" Content="Load more" Command="{Binding MoreCommand}" IsVisible="{Binding HasMore}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
     </Grid>
     <Grid IsVisible="{Binding ShowBrowse}" RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,16" IsVisible="{Binding ShowCreatePlaylist}"><TextBox Text="{Binding NewPlaylistName}" PlaceholderText="Playlist name"/><Button Grid.Column="1" Content="Create" Command="{Binding CreatePlaylistCommand}" Classes="primary" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Rename" Command="{Binding RenamePlaylistCommand}" Margin="8,0,0,0"/><Button Grid.Column="3" Content="Delete" Click="DeletePlaylistClicked" Margin="8,0,0,0"/></Grid><ListBox Grid.Row="1" x:Name="BrowseList" ItemsSource="{Binding BrowseItems}" SelectedItem="{Binding SelectedBrowseItem}" DoubleTapped="BrowseDoubleTapped"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="core:BrowseItem"><Grid ColumnDefinitions="52,*" Margin="0,8"><Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource RaisedBrush}" Width="40" Height="40"><Grid><ui:SwayIcon Kind="{Binding $parent[Window].DataContext.BrowseIconKind}" Opacity="0.5"/><ui:TrackCover Item="{Binding}" Owner="{Binding $parent[Window].DataContext}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
     <ScrollViewer IsVisible="{Binding ShowSettings}" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="14" MaxWidth="650" HorizontalAlignment="Stretch">
      <TextBlock Text="Make it yours" Classes="section"/><Grid ColumnDefinitions="*,*"><StackPanel Spacing="7"><TextBlock Text="Appearance" Classes="muted" FontSize="12"/><ComboBox x:Name="AppearancePicker" ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding Appearance}" HorizontalAlignment="Stretch" Margin="0,0,12,0"/></StackPanel><StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="Library density" Classes="muted" FontSize="12"/><CheckBox x:Name="CompactRowsCheck" Content="Compact song rows" IsChecked="{Binding CompactRows}"/></StackPanel></Grid>
      <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6"/>
      <TextBlock Text="Account" Classes="section"/>
      <TextBlock Text="Sign in with your Google account to use your YouTube Music recommendations. Finish signing in in the browser window, then return to Sway." TextWrapping="Wrap" Classes="muted" FontSize="13"/>
      <TextBlock Text="{Binding AccountStatus}" TextWrapping="Wrap"/><StackPanel IsVisible="{Binding IsSignedIn}" Spacing="6"><Button Content="Sync library" Command="{Binding SyncLibraryCommand}" IsEnabled="{Binding !IsSyncing}" HorizontalAlignment="Left"/><TextBlock Text="{Binding SyncStatus}" TextWrapping="Wrap" Classes="muted" FontSize="12"/></StackPanel>
      <WrapPanel>
       <Button x:Name="GoogleSignInButton" Content="Sign in with Google" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}" Classes="primary" Margin="0,0,8,0"/>
       <Button Content="Cancel sign-in" Command="{Binding CancelSignInCommand}" IsVisible="{Binding IsSigningIn}" Margin="0,0,8,0"/>
       <Button Content="Sign out" Command="{Binding SignOutCommand}" IsVisible="{Binding IsSignedIn}"/>
      </WrapPanel>
      <TextBlock Text="{Binding SignInProgress}" IsVisible="{Binding IsSigningIn}" TextWrapping="Wrap" Classes="muted"/>
      <TextBlock Text="Your session is encrypted for your Windows account. Sway never asks for your Google password." TextWrapping="Wrap" Classes="muted" FontSize="12"/>
      <Expander Header="Advanced: import a session" HorizontalAlignment="Stretch">
       <StackPanel Spacing="10" Margin="0,8,0,0">
        <TextBlock Text="If browser sign-in is unavailable, you can import your own YouTube Music Cookie request header. Never share it." TextWrapping="Wrap" Classes="muted" FontSize="12"/>
        <TextBox Text="{Binding CookieInput}" PasswordChar="●" PlaceholderText="Paste Cookie header" MaxLength="65536"/>
        <Button Content="Import session" Command="{Binding SaveAccountCommand}" HorizontalAlignment="Left"/>
       </StackPanel>
      </Expander>
      <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6"/><TextBlock Text="Playback &amp; storage" Classes="section"/><CheckBox Content="Fetch lyrics when opening the lyrics page" IsChecked="{Binding FetchLyrics}"/><Grid ColumnDefinitions="*,*"><StackPanel><TextBlock Text="Country (ISO code)" Classes="muted" FontSize="12"/><TextBox Text="{Binding Country}" MaxLength="2" Margin="0,7,12,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Language" Classes="muted" FontSize="12"/><TextBox Text="{Binding Language}" MaxLength="10" Margin="0,7,0,0"/></StackPanel></Grid><TextBlock Text="Download limit (MiB). Existing downloads are kept; remove songs to free space." Classes="muted" TextWrapping="Wrap" FontSize="12"/><NumericUpDown Value="{Binding DownloadBudgetMiB}" Minimum="64" Maximum="1048576" Increment="256" FormatString="0"/><Button Content="Save settings" Command="{Binding SaveSettingsCommand}" Classes="primary" HorizontalAlignment="Left"/>
      <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,6"/><TextBlock Text="SwayMusic" Classes="section"/><TextBlock Text="Find your rhythm." Classes="muted"/><TextBlock Text="Space: play/pause · Ctrl F: search · Ctrl O: files · Ctrl Left/Right: previous/next" TextWrapping="Wrap" Classes="muted" FontSize="12"/><TextBlock Text="Independent Windows port of Metrolist. GPL-3.0 · Metrolist Project and contributors. Signed-in collections sync with YouTube Music. Existing device playlists remain on this device." TextWrapping="Wrap" Classes="muted" FontSize="12" Margin="0,0,0,16"/>
     </StackPanel></ScrollViewer>
     <Grid IsVisible="{Binding ShowLyrics}" RowDefinitions="Auto,*"><TextBlock Text="{Binding ActiveLyric}" FontSize="24" Foreground="{DynamicResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/><ScrollViewer Grid.Row="1"><TextBlock Text="{Binding LyricsText}" TextWrapping="Wrap" FontSize="17" LineHeight="29"/></ScrollViewer></Grid>
    </Grid>
   </Grid>
   <Border Grid.Column="2" x:Name="SidePanel" IsVisible="{Binding IsSidePanelVisible}" Width="280" Padding="20,24,20,18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
    <Grid RowDefinitions="Auto,Auto,*">
     <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20"><StackPanel Orientation="Horizontal" Spacing="5"><Button Content="Queue" Command="{Binding SelectQueuePanelCommand}" Padding="8,5" FontSize="12"/><Button Content="Lyrics" Command="{Binding SelectLyricsPanelCommand}" Padding="8,5" FontSize="12"/></StackPanel><Button Grid.Column="1" Classes="icon" Command="{Binding ClosePanelCommand}" AutomationProperties.Name="Close side panel"><ui:SwayIcon Kind="close" Width="14"/></Button></Grid>
     <StackPanel Grid.Row="1" Spacing="10" Margin="0,0,0,24"><Border Height="172" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource RaisedBrush}"><Grid><Image Source="/Assets/sway.png" Width="58" Height="58" Opacity="0.3"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border><TextBlock Text="{Binding NowTitle}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/><ItemsControl ItemsSource="{Binding NowArtistLinks}" ItemTemplate="{StaticResource ArtistLinkTemplate}" ClipToBounds="True" MaxHeight="20"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel>
     <Grid Grid.Row="2" IsVisible="{Binding IsQueuePanel}" RowDefinitions="Auto,*,Auto"><TextBlock Text="UP NEXT" Classes="muted" FontSize="11" LetterSpacing="1.3" Margin="0,0,0,8"/><ListBox Grid.Row="1" x:Name="QueueList" ItemsSource="{Binding QueueTracks}" SelectedItem="{Binding SelectedQueueTrack}" ItemTemplate="{StaticResource TrackTemplate}" Tapped="QueueTapped"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"><Button Classes="icon" Command="{Binding QueueUpCommand}" AutomationProperties.Name="Move queued song up"><ui:SwayIcon Kind="up"/></Button><Button Classes="icon" Command="{Binding QueueDownCommand}" AutomationProperties.Name="Move queued song down"><ui:SwayIcon Kind="down"/></Button><Button Content="Remove" Command="{Binding QueueRemoveCommand}" FontSize="12"/></StackPanel></Grid>
     <ScrollViewer Grid.Row="2" IsVisible="{Binding IsLyricsPanel}"><StackPanel Spacing="18"><TextBlock Text="{Binding ActiveLyric}" Foreground="{DynamicResource SecondaryBrush}" FontSize="20" TextWrapping="Wrap"/><TextBlock Text="{Binding LyricsText}" Classes="muted" FontSize="14" LineHeight="25" TextWrapping="Wrap"/></StackPanel></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="1" IsVisible="{Binding HasStatus}" Background="{DynamicResource RaisedBrush}" Padding="18,8"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" Command="{Binding CancelCommand}" IsVisible="{Binding Busy}" IsEnabled="{Binding IsReady}" Margin="12,0,0,0"/><Button Content="Retry" Command="{Binding RetryStartupCommand}" IsVisible="{Binding CanRetryStartup}" Margin="12,0,0,0"/></StackPanel><Button Grid.Column="2" Classes="icon" Command="{Binding DismissStatusCommand}" IsEnabled="{Binding IsReady}" AutomationProperties.Name="Dismiss status"><ui:SwayIcon Kind="close" Width="12"/></Button></Grid></Border>
  <Border Grid.Row="2" IsEnabled="{Binding IsReady}" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="18,12">
   <Grid ColumnDefinitions="200,*,190" ColumnSpacing="12">
    <Grid ColumnDefinitions="48,*" VerticalAlignment="Center"><Border CornerRadius="7" Background="{DynamicResource RaisedBrush}" Width="44" Height="44" ClipToBounds="True"><Grid><ui:SwayIcon Kind="music"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4" Margin="10,0,0,0"><TextBlock Text="{Binding NowTitle}" FontWeight="Medium" TextTrimming="CharacterEllipsis" FontSize="13"/><ItemsControl ItemsSource="{Binding NowArtistLinks}" ItemTemplate="{StaticResource ArtistLinkTemplate}" ClipToBounds="True" MaxHeight="20"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Grid>
    <StackPanel Grid.Column="1" Spacing="7"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"><ToggleButton IsChecked="{Binding Shuffle}" ToolTip.Tip="Shuffle" AutomationProperties.Name="Shuffle"><ui:SwayIcon Kind="shuffle" Width="16"/></ToggleButton><Button Command="{Binding PreviousCommand}" Classes="icon" ToolTip.Tip="Previous" AutomationProperties.Name="Previous song"><ui:SwayIcon Kind="previous" Width="17"/></Button><Button Command="{Binding ToggleCommand}" Classes="primary player" ToolTip.Tip="{Binding PlayButtonText}" AutomationProperties.Name="{Binding PlayButtonText}"><Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><ui:SwayIcon x:Name="PlayPauseIcon" Kind="{Binding PlayIconKind}" Width="24" Height="24" Stretch="None" Stroke="{DynamicResource AccentForegroundBrush}" StrokeThickness="2.5"/></Canvas></Viewbox></Button><Button Command="{Binding NextCommand}" Classes="icon" ToolTip.Tip="Next" AutomationProperties.Name="Next song"><ui:SwayIcon Kind="next" Width="17"/></Button><Button Content="{Binding RepeatText}" Command="{Binding RepeatCommand}" Classes="icon" FontSize="11"/></StackPanel><Grid ColumnDefinitions="Auto,*,Auto"><TextBlock Text="{Binding PositionText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/><Slider Grid.Column="1" x:Name="SeekSlider" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" KeyUp="SeekKeyUp" Margin="10,0" Foreground="{DynamicResource AccentBrush}"/><TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/></Grid></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Right"><ui:SwayIcon Kind="volume" Width="17"/><Slider Width="65" Minimum="0" Maximum="100" Value="{Binding Volume}" ToolTip.Tip="Volume" Foreground="{DynamicResource AccentBrush}"/><Button Command="{Binding QueueCommand}" Classes="icon" ToolTip.Tip="Queue" AutomationProperties.Name="Queue"><ui:SwayIcon Kind="queue"/></Button><Button Command="{Binding LyricsCommand}" Classes="icon" ToolTip.Tip="Lyrics" AutomationProperties.Name="Lyrics"><ui:SwayIcon Kind="lyrics"/></Button></StackPanel>
   </Grid>
  </Border>
 </Grid>
</Window>
