<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:SwayMusic.Desktop.ViewModels" xmlns:ui="using:SwayMusic.Desktop.Controls"
 x:Class="SwayMusic.Desktop.OrbitView" x:DataType="vm:MainViewModel" Focusable="True" Background="{Binding OrbitBaseBrush}" Foreground="#F2F0E5">
 <UserControl.Styles>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="#F2F0E5"/></Style>
  <Style Selector="TextBlock.orbit-muted"><Setter Property="Foreground" Value="#ABB1A8"/></Style>
  <Style Selector="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#EBEDD9"/></Style>
  <Style Selector="ui|SwayIcon"><Setter Property="Stroke" Value="#CED4C3"/></Style>
  <Style Selector="ToggleButton:checked ui|SwayIcon"><Setter Property="Stroke" Value="#152019"/></Style>
  <Style Selector="Button.orbit-like.liked ui|SwayIcon"><Setter Property="Stroke" Value="#D6F68A"/><Setter Property="Fill" Value="#D6F68A"/></Style>
  <Style Selector="Button.orbit-repeat.enabled ui|SwayIcon"><Setter Property="Stroke" Value="#D6F68A"/></Style>
  <Style Selector="Slider"><Setter Property="Foreground" Value="#D6F68A"/></Style>
 </UserControl.Styles>
 <ThemeVariantScope RequestedThemeVariant="Dark">
 <Grid ClipToBounds="True">
  <Image x:Name="AmbientBackdrop" Source="{Binding OrbitBackdrop}" Stretch="UniformToFill" IsHitTestVisible="False"/>
  <Grid x:Name="OrbitLayout" RowDefinitions="Auto,*,Auto,Auto" Margin="48,28,48,30">
   <Grid x:Name="TopChrome" ColumnDefinitions="*,Auto">
    <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center"><TextBlock Text="sway" FontSize="30" FontWeight="SemiBold"/><Border Width="1" Height="23" Background="#536055"/><TextBlock Text="ORBIT" FontSize="14" LetterSpacing="6" VerticalAlignment="Center"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><ToggleButton x:Name="OrbitLyricsToggle" IsChecked="{Binding OrbitShowLyrics}" ToolTip.Tip="Show lyrics" AutomationProperties.Name="Show Orbit lyrics"><ui:SwayIcon Kind="lyrics"/></ToggleButton><ToggleButton x:Name="OrbitCalmToggle" IsChecked="{Binding OrbitCalm}" ToolTip.Tip="Calm mode · still halo" AutomationProperties.Name="Orbit calm mode"><ui:SwayIcon Kind="wave"/></ToggleButton><Button x:Name="MoveOrbitDisplayButton" Click="MoveDisplayClicked" ToolTip.Tip="Move Orbit to the next display" AutomationProperties.Name="Move Orbit to next display"><ui:SwayIcon Kind="monitor"/></Button><Button x:Name="ExitOrbitButton" Click="ExitClicked" ToolTip.Tip="Exit Orbit · Esc" AutomationProperties.Name="Exit Orbit"><StackPanel Orientation="Horizontal" Spacing="8"><ui:SwayIcon Kind="fullscreen"/><TextBlock Text="Exit" FontSize="13"/></StackPanel></Button></StackPanel>
   </Grid>
   <Grid Grid.Row="1" x:Name="OrbitScene" ColumnDefinitions="*,1.18*" ColumnSpacing="44" Margin="0,12,0,18">
    <StackPanel x:Name="DiscColumn" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
     <Viewbox x:Name="OrbitDisc" Width="440" Height="440"><Canvas Width="500" Height="500"><ui:OrbitHalo x:Name="Halo" Width="500" Height="500"/><Border x:Name="OrbitAlbumDisc" Canvas.Left="70" Canvas.Top="70" Width="360" Height="360" CornerRadius="180" ClipToBounds="True" RenderTransformOrigin="50%,50%" Background="#1F2923"><Grid><Image Source="/Assets/sway.png" Width="120" Height="120" Opacity="0.22"/><Image Source="{Binding Artwork}" Stretch="UniformToFill"/></Grid></Border></Canvas></Viewbox>
     <Grid x:Name="OrbitMetadata" ColumnDefinitions="*,Auto" Margin="52,10,24,0" MaxWidth="490"><StackPanel Spacing="8"><TextBlock Text="{Binding NowAlbum}" Classes="orbit-muted" FontSize="12" LetterSpacing="2" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding NowTitle}" FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="2"/><TextBlock Text="{Binding NowArtist}" Classes="orbit-muted" FontSize="18" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Command="{Binding LikeCurrentCommand}" IsEnabled="{Binding HasCurrentTrack}" Classes="icon orbit-like" Classes.liked="{Binding IsCurrentLiked}" VerticalAlignment="Center" ToolTip.Tip="Like or unlike this song" AutomationProperties.Name="Like current Orbit song"><ui:SwayIcon Kind="heart" Width="24" Height="24"/></Button></Grid>
    </StackPanel>
    <Grid Grid.Column="1" x:Name="OrbitLyricsArea" IsVisible="{Binding OrbitShowLyrics}" VerticalAlignment="Center" Margin="0,0,16,0" RowDefinitions="Auto,*">
     <TextBlock Text="LYRICS" FontSize="12" LetterSpacing="5" Classes="orbit-muted" Margin="0,0,0,25"/>
     <StackPanel Grid.Row="1" IsVisible="{Binding OrbitHasSyncedLyrics}" Spacing="18"><TextBlock x:Name="LyricBefore2" Text="{Binding OrbitPrevious2}" Opacity="0.28" FontSize="29" TextWrapping="Wrap" MaxLines="2"/><TextBlock x:Name="LyricBefore" Text="{Binding OrbitPrevious}" Opacity="0.55" FontSize="29" TextWrapping="Wrap" MaxLines="2"/><TextBlock x:Name="LyricNow" Text="{Binding OrbitCurrent}" FontSize="37" FontWeight="SemiBold" TextWrapping="Wrap" MaxLines="3"/><TextBlock x:Name="LyricAfter" Text="{Binding OrbitNext}" Opacity="0.55" FontSize="29" TextWrapping="Wrap" MaxLines="2"/><TextBlock x:Name="LyricAfter2" Text="{Binding OrbitNext2}" Opacity="0.28" FontSize="29" TextWrapping="Wrap" MaxLines="2"/></StackPanel>
     <ScrollViewer Grid.Row="1" x:Name="PlainLyricsScroll" MaxHeight="400" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !OrbitHasSyncedLyrics}"><TextBlock Text="{Binding LyricsText}" FontSize="23" LineHeight="38" Classes="orbit-muted" TextWrapping="Wrap"/></ScrollViewer>
    </Grid>
   </Grid>
  <Grid x:Name="OrbitAmbientProgressHost" Grid.Row="2" Width="740" Height="9" HorizontalAlignment="Center" Margin="0,0,0,22" IsHitTestVisible="False">
   <Border x:Name="OrbitAmbientTrack" Height="9" CornerRadius="4.5" Background="#22F2F0E5"></Border>
   <ProgressBar x:Name="OrbitAmbientProgress" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" Height="9" MinHeight="9" Foreground="#80F2F0E5" Background="Transparent" BorderThickness="0" ShowProgressText="False" AutomationProperties.Name="Song progress"></ProgressBar>
  </Grid>
   <Grid Grid.Row="3" x:Name="BottomChrome" RowDefinitions="Auto,Auto" RowSpacing="18">
    <Grid ColumnDefinitions="Auto,*,Auto"><TextBlock Text="{Binding PositionText}" FontSize="12" Classes="orbit-muted" VerticalAlignment="Center"/><Slider x:Name="OrbitSeekSlider" Grid.Column="1" Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds, Mode=OneWay}" KeyUp="SeekKeyUp" Margin="18,0"/><TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="12" Classes="orbit-muted" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*"><TextBlock Text="NOW PLAYING" FontSize="11" LetterSpacing="3" Classes="orbit-muted" VerticalAlignment="Center"/>
     <Grid Grid.Column="1" ColumnDefinitions="44,44,52,44,44" ColumnSpacing="14" HorizontalAlignment="Center"><ToggleButton Grid.Column="0" IsChecked="{Binding Shuffle}" ToolTip.Tip="Shuffle" AutomationProperties.Name="Orbit shuffle"><ui:SwayIcon Kind="shuffle"/></ToggleButton><Button Grid.Column="1" Command="{Binding PreviousCommand}" Classes="icon" AutomationProperties.Name="Previous Orbit song"><ui:SwayIcon Kind="previous"/></Button><Button x:Name="OrbitPlayPauseButton" Grid.Column="2" Command="{Binding ToggleCommand}" Classes="primary player" Width="50" Height="50" HorizontalAlignment="Center" ToolTip.Tip="{Binding PlayButtonText}" AutomationProperties.Name="{Binding PlayButtonText}"><Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"><Canvas Width="24" Height="24"><ui:SwayIcon x:Name="OrbitPlayPauseIcon" Kind="{Binding PlayIconKind}" Width="24" Height="24" Stretch="None" Stroke="#152019" StrokeThickness="2.5"/></Canvas></Viewbox></Button><Button Grid.Column="3" Command="{Binding NextCommand}" Classes="icon" AutomationProperties.Name="Next Orbit song"><ui:SwayIcon Kind="next"/></Button><Button Grid.Column="4" Command="{Binding RepeatCommand}" Classes="orbit-repeat" Classes.enabled="{Binding OrbitRepeatOn}" ToolTip.Tip="{Binding RepeatText}" AutomationProperties.Name="Orbit repeat"><Grid><ui:SwayIcon Kind="repeat"/><TextBlock Text="{Binding OrbitRepeatLabel}" FontSize="9" Foreground="#D6F68A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Button></Grid>
     <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><ui:SwayIcon Kind="volume"/><Slider Width="90" Minimum="0" Maximum="100" Value="{Binding Volume}" ToolTip.Tip="Volume"/><Button x:Name="OrbitQueueButton" Click="QueueClicked" ToolTip.Tip="Playback queue" AutomationProperties.Name="Orbit queue"><ui:SwayIcon Kind="queue"/></Button></StackPanel>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="OrbitQueuePanel" IsVisible="False" Background="#18211D" CornerRadius="14" BorderBrush="#364038" BorderThickness="1" Width="340" MaxHeight="460" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,38,150" Padding="18"><Grid RowDefinitions="Auto,*"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="UP NEXT" FontSize="12" LetterSpacing="2" VerticalAlignment="Center"/><Button Grid.Column="1" Click="QueueClicked" AutomationProperties.Name="Close Orbit queue"><ui:SwayIcon Kind="close"/></Button></Grid><ListBox x:Name="OrbitQueueList" Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding QueueTracks}" SelectedItem="{Binding SelectedQueueTrack}" Tapped="QueueTapped"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate x:DataType="vm:TrackRow"><StackPanel Spacing="3" Margin="0,5"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ArtistName}" Classes="orbit-muted" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>

 </Grid>
 </ThemeVariantScope>
</UserControl>
