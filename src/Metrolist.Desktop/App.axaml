<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Metrolist.Desktop.App" RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector=":is(Control)"><Setter Property="Transitions" Value="{x:Null}"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="13,8"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,3"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="#A6AFBE"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="6"/></Style>
    <Style Selector="ListBoxItem"><Setter Property="Padding" Value="12,9"/><Setter Property="MinHeight" Value="54"/></Style>
    <Style Selector="Button.accent"><Setter Property="Background" Value="#C7AEFF"/><Setter Property="Foreground" Value="#201435"/></Style>
    <Style Selector="ProgressBar"><Setter Property="ShowProgressText" Value="False"/></Style>
  </Application.Styles>
</Application>
